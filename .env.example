# GrudgeBlox production
GAME_SCRIPT=gtaLobbyScript.ts
GAME_TICKRATE=20
# Production must set one or more exact browser origins. FRONTEND_URL remains
# supported for existing deployments; ALLOWED_ORIGINS accepts a comma-separated list.
# ALLOWED_ORIGINS=https://approved.example
# FRONTEND_URL=https://approved.example
# Per-connection message budget; normal 20-40Hz gameplay remains below the default.
MAX_MESSAGES_PER_SECOND=80
# Optional authenticated, in-memory event feed. Leave unset to disable /admin/events.
# ADMIN_API_TOKEN=
# Optional host/container listen port; defaults to 8001.
# GAME_PORT=8001
# Optional standard platform port; when set, PORT takes precedence over GAME_PORT.
# PORT=8001

# Island / Super Terrain sandboxes
# GAME_SCRIPT=islandSandboxScript.ts
# ISLAND_MAP=harbor-atoll|volcanic-ridge|frozen-fjord|alpine-mesh|granite-csg|spline-forest|tunnel-cavern
# ISLAND_ENGINE_ROOT=/path/to/Island-Terrain-World-Engine
# SUPER_TERRAIN_ROOT=/path/to/super-terrain-export
# Live fleet: docker compose -f docker-compose.sandboxes.yml up -d  (ports 8001–8012)
# Compose image override. Production should pin an immutable SHA or digest.
# GRUDGEBLOX_GAME_IMAGE=ghcr.io/molochdagod/grudgeblox-game-server:<commit-sha>
# Optional: GRUDGE_ASSETS_CDN=https://assets.grudge-studio.com

# Dope Budz Streets (dedicated live world)
# GAME_SCRIPT=dopebudzStreets.ts
# Compose service game_dopebudz_streets → host :8005
# Standalone Railway root: dopebudz-streets/
# Optional integrated ECS tuning:
# DOPEBUDZ_STARTING_BUDZ=500
# DOPEBUDZ_STARTING_SOL=1.5
# DOPEBUDZ_GROW_COST=20
# DOPEBUDZ_GROW_REWARD=80
# DOPEBUDZ_GROW_SECONDS=45
# Local/offline fallback only; production keeps the existing external map by default.
# DOPEBUDZ_SKIP_EXTERNAL_MAP=true
# Broader isolated-server fallback; also implies map fallback and replaces remote-mesh cars/crews with markers.
# DOPEBUDZ_SKIP_EXTERNAL_ASSETS=true

# Front (Vercel)
# NEXT_PUBLIC_SERVER_URL=wss://blox-game.grudge-studio.com
# Or multiport local: NEXT_PUBLIC_SERVER_URL=ws://localhost
# The separate JSON compatibility service is not consumed by the current Next.js client.
# Legacy/compatible JSON clients may still use:
# VITE_LIVE_WS=wss://dopebudz-live.up.railway.app
