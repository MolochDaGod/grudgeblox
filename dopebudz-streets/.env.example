# Optional JSON compatibility instance. The main GrudgeBlox frontend uses the
# integrated ECS server with GAME_SCRIPT=dopebudzStreets.ts instead.
PORT=8001
LISTEN_HOST=0.0.0.0
GAME_TICKRATE=20
INSTANCE_ID=dopebudz-compat

# Comma-separated browser origins. Empty preserves the existing open-origin behavior.
ALLOWED_ORIGINS=
MAX_CLIENTS=100
MAX_PAYLOAD_BYTES=4096
MAX_MESSAGES_PER_SECOND=30

# Compatibility switches preserve the existing JSON protocol defaults.
ALLOW_CLIENT_HP=true
ALLOW_PLOT_CLAIMS=true
