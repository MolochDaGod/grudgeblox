# Local single-backend development. When a loopback URL has no explicit port,
# every world uses the normal local GrudgeBlox backend on port 8001.
NEXT_PUBLIC_SERVER_URL=ws://127.0.0.1

# Optional public fleet asset base used by the character/avatar UI.
NEXT_PUBLIC_FLEET_ASSETS=https://assets.grudge-studio.com

# Deployment credentials such as VERCEL_OIDC_TOKEN do not belong in this file.
# Supply deployment credentials through the deployment platform's secret store.
