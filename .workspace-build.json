    {
      "id": "shire",
      "label": "The Shire local world",
      "relative": "front",
      "output": "shire",
      "kind": "next",
      "buildScript": "build:shire",
      "launchScript": "start",
      "installer": false,
      "lifecycleScript": "Workbench-Portal.ps1",
      "requires": [
        "Staged Next dependencies",
        "Retained C: world assets"
      ],
      "notes": [
        "Local-only server, C: saves and active Workbench library; D: runtime, build and logs."
      ],
      "launchOptionOnBuildCompletion": true
    }
  ],
  "packages": {
    ".": {
      "scripts": {
        "build:shared": "pnpm --filter @notblox/shared run build",
        "dev:shared": "pnpm --filter @notblox/shared run dev",
        "build:back": "pnpm --filter @notblox/back run build",
        "dev:back": "pnpm --filter @notblox/back run dev",
        "build:front": "pnpm --filter @notblox/front run build",
        "dev:front": "pnpm --filter @notblox/front run dev",
        "test:back": "pnpm --filter @notblox/back run test",
        "test:client:reliability": "pnpm --filter @notblox/back exec tsx --tsconfig ../front/tsconfig.json --test ../front/lib/guidedReliability.test.ts",
        "build-vercel": "pnpm run build:shared && pnpm run build:front",
        "build": "pnpm run build:shared && pnpm run build:back && pnpm run build:front",
        "validate:avatars": "node front/scripts/validate-avatar-orientation.mjs",
        "bake:islands": "pnpm --filter @notblox/back run bake:islands",
        "dev": "concurrently \"pnpm run dev:shared\" \"pnpm run dev:back\" \"pnpm run dev:front\"",
        "lag:up": "sudo tc qdisc add dev lo root netem delay 100ms",
        "lag:down": "sudo tc qdisc del dev lo root netem"
      },
      "packageManager": "pnpm@11.19.0",
      "name": "notblox-mono"
    },
    "back": {
      "scripts": {
        "debug": "node --import tsx/esm --inspect=7000 src/sandbox.ts",
        "dev": "tsx watch src/sandbox.ts",
        "build": "tsc --noEmit",
        "start": "node --import tsx/esm src/sandbox.ts",
        "test": "tsx --test src/gameSupervisor.test.ts src/physics/colliderBudget.test.ts src/ecs/system/network/serverPolicy.test.ts src/ecs/system/network/nodeWebSocketTransport.test.ts src/ecs/system/network/nodeSocketAccept.test.ts src/ecs/system/network/appearancePolicy.test.ts src/ecs/entity/Player.test.ts src/maps/islandBake.test.ts src/maps/superTerrainBake.test.ts src/maps/islandLive.test.ts src/maps/playScale.test.ts ../front/lib/avatarTransformContract.test.ts ../front/lib/characterEras.test.ts ../front/game/thirdPersonCamera.test.ts ../front/game/gamepad.test.ts ../front/game/playHud.test.ts ../front/game/pointerLock.test.ts ../front/game/renderLayers.test.ts ../front/game/avatarAnimator.test.ts ../front/game/hudLayers.test.ts ../front/game/InputTransmission.test.ts",
        "bake:islands": "tsx scripts/bakeIslands.ts",
        "smoke:network": "node scripts/networkSmoke.mjs",
        "smoke:dependencies": "node scripts/dependencySmoke.mjs",
        "lint": "eslint src/",
        "format": "eslint src/ --fix"
      },
      "packageManager": null,
      "name": "@notblox/back"
    },
    "dopebudz-streets": {
      "scripts": {
        "start": "node index.mjs",
        "check": "node --check index.mjs && node --check compatibilityServer.mjs"
      },
      "packageManager": null,
      "name": "dopebudz-live"
    },
    "front": {
      "scripts": {
        "dev": "next dev -p 4000",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "serve": "serve -s public/assets -l 4001 --cors",
        "build:shire": "node ../scripts/build-shire.mjs"
      },
      "packageManager": null,
      "name": "@notblox/front"
    },
    "monitor": {
      "scripts": {
        "build": "tsc",
        "start": "node dist/monitor.js"
      },
      "packageManager": null,
      "name": "notblox-monitor"
    },
    "shared": {
      "scripts": {
        "build": "tsc --build tsconfig.json",
        "dev": "tsc --watch --project tsconfig.json"
      },
      "packageManager": null,
      "name": "@notblox/shared"
    }
  },
  "nativeEntries": [],
  "preexistingTrackedChanges": [],
  "releaseOnly": false,
  "storageProfile": ".storage/profile.json",
  "storageDevice": ".storage/device.json",
  "workspaceWorkflow": {
    "script": "Workspace-Shire.ps1",
    "label": "The Shire local world",
    "launchComponents": [
      "shire"
    ]
  }
}
